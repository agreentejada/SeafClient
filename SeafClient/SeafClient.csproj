<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <RootNamespace>SeafClient</RootNamespace>

    <Version>2.0.0</Version>
    <Authors>René Bergelt; agreentejada</Authors>
    <Description>Strongly-typed async .NET client for the Seafile Web API (targets Seafile 11-14).</Description>
    <Copyright>Copyright © 2016-2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/agreentejada/SeafClient</PackageProjectUrl>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SeafClient.Tests" />
  </ItemGroup>

</Project>
